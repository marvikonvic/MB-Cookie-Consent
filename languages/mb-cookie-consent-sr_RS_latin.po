#. Plugin Name of the plugin
#: mb-cookie-consent.php includes/class-mbcc-settings.php:145
#: includes/class-mbcc-settings.php:146 includes/class-mbcc-settings.php:219
msgid "MB Cookie Consent"
msgstr "MB saglasnost za kolačiće"

#. Description of the plugin
#: mb-cookie-consent.php
msgid ""
"Bilingual, privacy-first cookie consent and script blocking for WordPress."
msgstr ""
"Dvojezična saglasnost za kolačiće i blokiranje skripti sa privatnošću na "
"prvom mestu za WordPress."

#. Author of the plugin
#: mb-cookie-consent.php
msgid "MB"
msgstr "MB"

#: includes/class-mbcc-settings.php:160
msgid "Settings"
msgstr "Podešavanja"

#: includes/class-mbcc-settings.php:220
msgid ""
"Bilingual consent banner and cache-safe blocking for standard WordPress "
"frontends, classic themes and Blogsy."
msgstr ""
"Dvojezični baner za saglasnost i blokiranje bezbedno za keširanje za "
"standardni WordPress frontend, klasične teme i Blogsy."

