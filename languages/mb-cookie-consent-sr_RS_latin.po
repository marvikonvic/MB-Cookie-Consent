#: includes/class-mbcc-settings.php:251
msgid "Blocking rules"
msgstr "Pravila blokiranja"

#: includes/class-mbcc-settings.php:252
msgid "Use one rule per line in the format value|category. Allowed categories: necessary, preferences, analytics, marketing."
msgstr "Koristite jedno pravilo po redu u formatu vrednost|kategorija. Dozvoljene kategorije: necessary, preferences, analytics, marketing."

#: includes/class-mbcc-settings.php:254
