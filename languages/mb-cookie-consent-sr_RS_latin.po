msgstr "Omogući blokiranje skripti i iframe elemenata na osnovu URL-a"

#: includes/class-mbcc-settings.php:255
msgid "WordPress script handles"
msgstr "WordPress oznake skripti"

#: includes/class-mbcc-settings.php:256
