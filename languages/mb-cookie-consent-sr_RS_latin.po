msgstr "URL obrasci skripti"

#: includes/class-mbcc-settings.php:257
msgid "Iframe URL patterns"
msgstr "Iframe URL obrasci"

#: includes/class-mbcc-settings.php:258
msgid "Cookies to remove after rejection"
msgstr "Kolačići za uklanjanje nakon odbijanja"

#: includes/class-mbcc-settings.php:261
msgid "Serbian Latin frontend text"
msgstr "Tekst frontenda na srpskom (latinica)"

#: includes/class-mbcc-settings.php:262
